{
    "keyboard_name": "gaming hackpad",
    "manufacturer": "me",
    "maintainer": "me",

    "processor": "RP2040",
    "bootloader": "rp2040",
    "board": "GENERIC_RP_RP2040",

    "usb": {
        "vid": "0xFEED",
        "pid": "0x6060",
        "device_version": "1.0.0"
    },

    "features": {
        "bootmagic": true,
        "encoder": true,
        "mousekey": true,
        "extrakey": true
    },

    "matrix_pins": {
        "direct": [
            ["GP0", "GP7", "GP6"],
            ["GP29", "GP27", "GP26"]
        ]
    },

    "encoder": {
        "enabled": true,
        "rotary": [
            {
                "pin_a": "GP28",
                "pin_b": "GP1"
            }
        ]
    },

    "layouts": {
        "LAYOUT": {
            "layout": [
                { "matrix": [0, 0], "x": 0, "y": 0 },
                { "matrix": [0, 1], "x": 1, "y": 0 },
                { "matrix": [0, 2], "x": 2, "y": 0 },

                { "matrix": [1, 0], "x": 0, "y": 1 },
                { "matrix": [1, 1], "x": 1, "y": 1 },
                { "matrix": [1, 2], "x": 2, "y": 1 }
            ]
        }
    }
}